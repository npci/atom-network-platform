# Root .env — datastore credentials and the certification-simulator token.
#
# Copy to `.env` in this directory before starting the stack:
#
#     cp .env.example .env
#
# Docker Compose reads this file for VARIABLE INTERPOLATION in
# docker-compose.yml. It is distinct from `backend/.env`, which is passed to
# the backend, celery and celery_beat containers as their environment (see
# `env_file:` in the compose file). You need both.
#
# All three values below are declared in docker-compose.yml as
# `${VAR:?VAR must be set}`, so compose refuses to start without them rather
# than silently falling back to a published default. That is deliberate: a
# datastore password with a repository default is a datastore with no password.

# ── Postgres ─────────────────────────────────────────────────────────────────
# Used for the pgvector database and interpolated into DATABASE_URL for the
# backend, celery and celery_beat services.
POSTGRES_PASSWORD=change-me-before-starting

# ── Redis ────────────────────────────────────────────────────────────────────
# Celery broker and result backend, the HMAC nonce store, and the shared
# rate-limit counters.
REDIS_PASSWORD=change-me-before-starting

# ── Certification simulator ──────────────────────────────────────────────────
# Shared secret nginx presents to the certification simulator context. Any
# value works for a local stack that is not exercising certification; it must
# match the simulator's own setting where one is deployed.
CERTSIM_INTERNAL_TOKEN=local-dev-token

# ── Optional overrides ───────────────────────────────────────────────────────
# Uncomment only if you need them; every one has a working default.
#
# Phase B runner mode: demo (fully simulated, the default), build (real mvn
# build, no deploy), ssh, or local. See docker-compose.yml for the full note.
# PHASE_B_RUNNER_MODE=demo
#
# Cross-encoder reranker sidecar. Start it with
# `docker compose --profile reranker up -d` and set USE_RERANKER=true in
# backend/.env; without both, retrieval falls back to RRF ordering.
# RERANKER_BACKEND=remote
#
# Negotiation round window in minutes. Default 1440 (24h) matches production;
# lower it to exercise the round-close and silent-acceptance sweeps quickly.
# NEGOTIATION_ROUND_MINUTES=1440
#
# UI label profile. Empty renders the ecosystem-neutral defaults in
# frontend/src/strings.js; a profile JSON supplies deployment wording.
# LABEL_PROFILE=labels.mydomain.json
