# ─────────────────────────────────────────────────────────────────────────────
# A2A Change Management Platform — backend env template.
#
# Copy to `.env` (which is gitignored), then fill in real values for the
# secret-marked fields below. `.env` is read by:
#   - the local backend process (uvicorn / Celery / one-shot scripts)
#   - docker-compose's `env_file:` directive for backend, celery, celery_beat
# Some values are also set explicitly under each service's `environment:` in
# docker-compose.yml — those WIN over .env when the stack is running in Docker.
# Specifically: DATABASE_URL, REDIS_URL, OLLAMA_URL are docker-compose-overridden
# so the in-network service names resolve correctly inside the containers.
#
# CONFIG SOURCE OF TRUTH: operator-tunable settings (AI provider/models; GitLab/
# SMTP/Jenkins/UAT endpoints) AND secrets (API keys, tokens, passwords) are owned
# by the DB and edited in Admin → Configuration — that is the single edit surface
# at runtime. Secrets are stored ENCRYPTED (see CONFIG_ENCRYPTION_KEY below). The
# AI / GitLab / SMTP / Jenkins / UAT keys in this file are only first-run bootstrap
# defaults; once a value is set in the UI the DB wins. Infra (DATABASE_URL,
# REDIS_URL, OLLAMA_URL, paths, PHASE_B_*, CORS/A2A URLs) and the USE_* / AGENTIC_*
# feature flags remain env-owned and are NOT in the admin UI.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME="Change Management Platform"
APP_ENV=development                                  # development | staging | production
SECRET_KEY=change-this-to-a-long-random-string       # JWT signing key
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Operator sessions are delivered as an httpOnly `atom_session` cookie, so the
# browser holds the JWT somewhere JavaScript cannot read it. Set this to true
# ONLY for a non-browser caller that cannot keep a cookie jar and must scrape
# the token out of the /auth/login response body. Leaving it false is what
# keeps the credential out of web storage.
#   Secure flag is applied automatically when APP_ENV=production.
AUTH_RETURN_TOKEN_IN_BODY=false

# ── Secret encryption (REQUIRED to store secrets in the DB) ──────────────────
# Key-encryption key for secrets kept in the app_configs table (all admin-UI
# secrets: *_API_KEY, GITLAB_TOKEN, SMTP_PASSWORD, JENKINS_TOKEN) AND for the
# partner_agents table's credentials (api_key, jwt_signing_secret,
# signing_secret, and their previous_* rotation-grace-period copies — see
# core/encrypted_type.py). Same key, same Fernet mechanism, same enc:v1:
# on-disk format for both. The only secret that must live in .env — you
# can't bootstrap DB-stored secrets without it. Outside development,
# storing a secret with this unset is refused. Generate:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONFIG_ENCRYPTION_KEY=

# DEV ONLY — auto-approves BRD on submit so the rest of the workflow is
# unblocked without registering reviewer users. MUST be False in production
# (the host refuses to honour it when APP_ENV=production anyway).
DEV_SKIP_APPROVALS=true

# ── Database ─────────────────────────────────────────────────────────────────
# This value is for running the backend OUTSIDE Docker (against the dockerised
# Postgres on its host port). Inside Docker, docker-compose.yml overrides this
# to use the internal `postgres` service hostname.
# Replace `<set-postgres-password>` with the password the Postgres container was started with.
# docker-compose.yml now requires POSTGRES_PASSWORD to be set explicitly.
DATABASE_URL=postgresql://atom_user:<set-postgres-password>@localhost:6432/atom_cm_db

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Authentication & login hardening (InfoSec) ───────────────────────────────
# Self-hosted login CAPTCHA (image challenge; answers held in Redis). Verifies
# fail-CLOSED when Redis is down. Set false for programmatic login (e2e / seed /
# eval scripts — a script cannot solve a CAPTCHA).
CAPTCHA_ENABLED=true

# Platform-wide TOTP MFA switch. true = every user must use MFA (a user who
# hasn't set it up registers at first login); false = no MFA prompt. Enrolment
# persists per user across toggles. Keep SECRET_KEY stable — the TOTP secret is
# encrypted with a key derived from it, unless MFA_ENCRYPTION_KEY is set below.
MFA_ENFORCED=false
MFA_ISSUER="Change Management"                              # label shown in the authenticator app

# Optional. A dedicated Fernet key for encrypting TOTP seeds at rest, so MFA
# storage doesn't share a key with session-JWT signing (SECRET_KEY). Unset
# (default) keeps today's behaviour — the key is derived from SECRET_KEY, as
# before. Setting this, like rotating SECRET_KEY, invalidates stored TOTP
# secrets — users re-enrol. Generate with the same command as
# CONFIG_ENCRYPTION_KEY above:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=

# Fail CLOSED (503) when Redis — which backs lockout / CAPTCHA / JWT denylist —
# is down, instead of silently losing those controls. Default off (availability).
LOGIN_FAIL_CLOSED_WITHOUT_REDIS=false

# ── Hybrid LDAP / Active Directory auth ──────────────────────────────────────
# When enabled, unknown usernames (and users whose row is auth_source='ldap')
# authenticate by BIND against the directory and are JIT-provisioned on first
# login; local users (incl. a break-glass admin) keep bcrypt. Keep >=1 local
# admin so an AD/LDAPS outage can't lock everyone out. Requires the `ldap3`
# package and migration 0101 (users.auth_source).
LDAP_ENABLED=false

# LDAPS endpoint — prefer ldaps:// (plaintext ldap:// is refused by policy).
LDAP_SERVER_URI=ldaps://ad.example.com:636

# Read-only service account for the user search (from your AD / InfoSec team).
LDAP_BIND_DN=CN=svc-account,OU=Service Accounts,DC=example,DC=internal
LDAP_BIND_PASSWORD=<set-ldap-bind-password>

# Where to search, and the attribute that matches the typed username.
LDAP_USER_SEARCH_BASE=OU=Users,DC=example,DC=internal
LDAP_USER_FILTER=(sAMAccountName={username})

# AD group DN -> app role. VALID JSON on ONE line; first matching group wins.
# Roles: product_owner | product_manager | tech_lead | infosec_reviewer |
#        risk_reviewer | admin. A user in no mapped group is denied login.
LDAP_GROUP_ROLE_MAP={"CN=CM-Admins,OU=Groups,DC=example,DC=internal":"admin","CN=CM-TechLeads,OU=Groups,DC=example,DC=internal":"tech_lead"}

# PEM file that signs the AD LDAPS certificate (path on the host / container).
LDAP_CA_CERT=/data2/appdata/agentapp/certs/ad-ca.pem

# Only if you must use ldap:// + STARTTLS instead of ldaps://.
LDAP_START_TLS=false

# ── LLM provider ─────────────────────────────────────────────────────────────
# Pick one: claude | openai | ainxt | ollama | gemini
# Cross-laptop default is `claude` — every developer brings their own
# ANTHROPIC_API_KEY (free $5 credit on signup; engine usage costs ~$0.10
# per cert_test_cases generation).
LLM_PROVIDER=claude

# Anthropic prompt caching (Claude / AiNxt-anthropic paths). Default true —
# caches the system prompt, tools block and message tail for lower cost/latency.
# Set false to strip all cache_control markers (debugging / provider quirks).
# No effect on non-Claude providers.
PROMPT_CACHE_ENABLED=true

# REQUIRED if LLM_PROVIDER=claude. Get one at console.anthropic.com.
# DO NOT commit this file with a real key. .env is gitignored.
ANTHROPIC_API_KEY=sk-ant-replace-me
CLAUDE_MODEL=claude-sonnet-4-6

# Optional fallbacks (only used when LLM_PROVIDER matches)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_THINKING_LEVEL=minimal
GEMINI_THINKING_BUDGET=0
AINXT_BASE_URL=
AINXT_API_KEY=
AINXT_MODEL=claude-sonnet-4-6
OLLAMA_CHAT_MODEL=phi3:mini

# Per-purpose routing — leave OFF unless you have explicit reason. When ON,
# routing/utility purposes use cheaper models (claude-haiku) regardless of
# LLM_PROVIDER. If you switch provider away from Claude, leave the routing
# model ids EMPTY so they fall back to the provider's default.
USE_LLM_ROUTING=False
ROUTING_MODEL_ROUTING=
ROUTING_MODEL_UTILITY=
ROUTING_MODEL_REASONING=

# ── Embeddings (Ollama, local) ───────────────────────────────────────────────
# Embeddings always go through Ollama running nomic-embed-text. Inside the
# docker-compose stack an `ollama` service is bundled — docker-compose.yml
# overrides this URL to http://ollama:11434, and the `ollama_init` service
# pulls the model on first run.
#
# Outside Docker (running uvicorn directly on your laptop), install Ollama
# from ollama.com, then `ollama pull nomic-embed-text`, then leave the URL
# below as localhost.
OLLAMA_URL=http://localhost:11434

# ── Email (optional — used by approval notifications) ────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@example.com

# Stamped into the JWT `iss` claim. Nothing verifies it, so changing it cannot
# invalidate a live session; set it to your organisation's identifier.
JWT_ISSUER=change-management-platform

# ── Storage paths ────────────────────────────────────────────────────────────
# Inside Docker these resolve via volume mounts. Outside Docker, set them to
# absolute paths on your laptop (the folders must exist & be writeable).
ARTIFACTS_DIR=/app/artifacts
KNOWLEDGE_BASE_DIR=/app/knowledge_base

# Auto-ingest knowledge_base/ into pgvector on backend startup. Idempotent —
# only embeds files whose chunks aren't already in the document_chunks table.
AUTO_INGEST_KNOWLEDGE_BASE_ON_STARTUP=True
STARTUP_INGEST_FORCE=False
STARTUP_INGEST_BACKGROUND=True

# ── CORS ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── GitLab integration (optional — Phase B / code-change features) ───────────
GITLAB_URL=
GITLAB_TOKEN=
# Write-scoped token used ONLY for the Phase B code push (needs write_repository +
# Developer on the target repo). GITLAB_TOKEN above only clones/indexes (read).
# Leave blank to reuse GITLAB_TOKEN for the push.
GITLAB_PUSH_TOKEN=
GITLAB_REPO=
GITLAB_BRANCH=main

# ── Feature flags (RAG / chunking / retrieval) ───────────────────────────────
# Sensible defaults for a developer laptop. Toggle off the heavy ones if RAM
# is tight (each adds DB rows and / or background work).
USE_TREE_SITTER_CHUNKER=True
USE_SYMBOL_GRAPH_EXTRACTOR=True
USE_CODE_MULTIVIEW_EMBEDDING=True
USE_PYTHON_LSP=False
USE_TYPESCRIPT_LSP=False
USE_JAVA_LSP=False
USE_KG_INGESTION=True
USE_GRAPH_RETRIEVAL=False
USE_IMPACT_ANALYZER=False
USE_DOC_CODE_LINKING=True
USE_HIERARCHICAL_CHUNKER=True
USE_QUERY_UNDERSTANDING=False
USE_RERANKER=False
USE_CONTEXT_COMPRESSION=False
USE_CITATION_ENFORCEMENT=True
USE_OBSERVABILITY_TRACES=True

# ── Docgen diagrams (Mermaid) ────────────────────────────────────────────────
# Mermaid rendering needs the mmdc CLI (node + chromium). Two ways to get it:
#   1. Baked into the backend image: build with --build-arg INSTALL_MERMAID=true.
#   2. NATIVE (non-docker) deployments where installing node/chromium is hard
#      (air-gapped prod, verified working): just pull the default image and
#      the backend auto-detects it, rendering each diagram via `docker run` —
#      nothing to configure:
#        docker pull minlag/mermaid-cli:11.4.2
#      Set the var below only to point at a DIFFERENT image/tag than the
#      default minlag/mermaid-cli (air-gapped sites point this at
#      their own registry mirror).
#      Not applicable when the backend itself runs inside docker (bind-mount
#      paths would not resolve on the daemon's host — use option 1 there).
# With neither an mmdc install nor any pulled image, diagrams fall back to
# PlantUML/Pillow (always available).
MERMAID_DOCKER_IMAGE=

# ── Sandbox / code-change loop (only for Phase B) ────────────────────────────
# PHASE_B_DEMO_FORCE_SUCCESS was removed: it reported a FAILED build as SUCCESS,
# which is indefensible in a tool whose job is telling you whether your change
# builds. For a demo that needs green output, use PHASE_B_RUNNER_MODE=demo —
# fully simulated and labelled as such, rather than a real failure relabelled.
SANDBOX_ENABLED=True
USE_SELF_CORRECTION=True
USE_AST_EDITOR=True

# ── Pre-build governance reviews (EA + InfoSec) ──────────────────────────────
# Two review stages that gate Build: EA Review, then InfoSec Review. Each runs
# an uploaded rulebook ("governance skill") against the approved change and
# returns an explicit PASS/FAIL per rule, with a human approval gate.
#
# OFF by default. With the flag off the Phase B page shows no governance cards
# and Build is not gated — the feature is simply absent, with no error.
# GOVERNANCE_REVIEWS_ENABLED=true
#
# Turning the flag on is NOT sufficient — the rulebooks live in the database,
# not in code, and nothing seeds them automatically. Load the two shipped
# generic examples (12 EA + 12 InfoSec rules, domain-neutral):
#
#     docker compose run --rm backend python scripts/seed_governance_skills.py
#
# ...or upload your own under Admin -> Governance Skills. Idempotent; safe to
# re-run. Without this, POST /governance/start returns 409 naming the missing
# rulebook — loud, but only at the moment a user tries to start a review.
#
# Also required: a working LLM key (reviews are real model calls) and a running
# Celery worker — stages dispatch to it, so with no worker a review is created
# and then sits at `pending` indefinitely.
#
# Max fix rounds per stage before the run parks for a human (default 2).
# GOVERNANCE_MAX_FIX_ROUNDS=2

# ── Phase B script-based Build + UAT ─────────────────────────────────────────
# The Build and UAT steps run an OPERATOR-SUPPLIED shell script and parse its
# output. Nothing about the scripts is platform-specific — the contract is:
#
#   build+deploy   bash <script> <core_branch> <app_branch>   exit 0 = success
#   UAT            bash <script> [base_url]                   one PASS/FAIL/SKIP
#                                                             line per case, then
#                                                             TESTS: total=N passed=N failed=N
#
# Every other output cue (`== Deploy ==`, `Building jar: <p>`, `cp <a> <b>`) is
# optional enrichment for the UI. Working samples: backend/examples/phase_b_scripts.
#
# demo = fully simulated, no host needed. local = run on the backend host.
# ssh = run on PHASE_B_HOST (the script must exist THERE, not here).
# PHASE_B_RUNNER_MODE=demo
#
# Default build+deploy script, used when the Build panel's script field is left
# empty — which is exactly what that field's placeholder promises. Leave this
# unset and an empty field has nothing to run: the trigger fails immediately
# with a "no build+deploy script to run" message naming this setting. Absolute
# path; operator config, so NOT confined to PHASE_B_SCRIPT_ROOT.
# PHASE_B_BUILD_SCRIPT=/opt/scripts/build_and_deploy.sh
#
# Same idea for UAT. Runs on the backend host in ANY runner mode — UAT scripts
# are HTTP clients of the deployed stack.
# PHASE_B_TEST_SCRIPT=/opt/scripts/run_uat_tests.sh
#
# Allowlist root for script paths typed into the Build/UAT panels. A supplied
# path must resolve (symlinks included) to a regular *.sh file INSIDE this root,
# and is honoured only in `local` mode for admin/tech_lead. Unset = panel input
# disabled entirely; the two fixed scripts above are the only ones that run.
# PHASE_B_SCRIPT_ROOT=/opt/scripts
#
# Hard wall-clock ceiling per script run; on expiry the process is killed and
# the run is recorded failed. Raise it before pointing at a real multi-module
# build — 3600s is short for one.
# PHASE_B_SCRIPT_TIMEOUT_SECONDS=3600

# Per-change transcript tree (app.core.transcripts). ONE JSON file per LLM call across the
# WHOLE change lifecycle, filed so one change's logs stay findable when many run at once:
#   <dir>/<change_id>/01_prompt_enhancement | 03_deep_research | 05_brd | 07_planning | …
#                     08_codegen/<run_id>/<agent>/<passNN_trigger>/<ts>_iterNNN.json
# Verbatim + secret-redacted + fail-open. Filenames are timestamp-first, so plain lexical
# order IS chronological order.
#
# ON by default, and it SUPERSEDES AGENTIC_DUMP_TRANSCRIPTS below: leaving that one false
# no longer keeps codegen quiet, because the dump is gated on (either flag). Payloads are
# large (~250 KB per call — they embed repo source) and there is NO automatic retention,
# so set this false on any deployment where that disk growth is unwanted.
TRANSCRIPT_CAPTURE=true
# Blank dir → transcripts/ beside CODING_LOG_DIR.
# AGENTIC_TRANSCRIPT_DUMP_DIR=/app/logs/transcripts

# LEGACY toggle, agentic-loop dump only, kept for back-compat. OR-ed with TRANSCRIPT_CAPTURE,
# so on its own it can no longer switch capture OFF.
AGENTIC_DUMP_TRANSCRIPTS=false

# ── Agentic XSD-driven codegen (THE BOOK v3.4) ───────────────────────────────
USE_AGENTIC_TOOL_LOOP=True
USE_MODULE_CONTEXT_GENERATION=True
USE_FLOW_CONTEXT_GENERATION=True        # index-time API flow map (reuse-first)
AGENTIC_VERIFIER=auto                    # auto | local | ci | off
AGENTIC_APPROACH_GATE=True               # reuse-vs-new options gate before any edit
AGENTIC_WRITE_UNIT_TESTS=False           # agent does NOT author unit tests (land separately)
AGENTIC_MIN_DISK_FREE_MB=3000            # refuse a new clone below this free space (0 = off)
# Java LSP (Eclipse jdtls) inline diagnostics, offered to the code agent as a tool.
# PROD: true — run on a high-RAM dev/prod host (jdtls is a 0.5–1 GB+ JVM server, and
# the image must be built with INSTALL_JDTLS=true). LOCAL: keep false (it OOMs a small
# box; the agent falls back to verify_change / `mvn -o compile`).
AGENTIC_LSP_ENABLED=true                  # ← prod; set to false in your local .env
AGENTIC_LSP_HOME=/opt/jdtls
AGENTIC_LSP_HEAP_MB=2048
AGENTIC_LSP_TIMEOUT_S=90
# Address-space cap (MB) for agentic child processes (mvn, git, etc.).
# 0 = disabled. Set to e.g. 4096 in prod to prevent a runaway build from
# consuming all memory on the host.
AGENTIC_RLIMIT_AS_MB=0
# Namespace prefix for the branch the agent pushes — becomes "<prefix>/xsd-<slug>",
# distinguishing agent branches from human ones. Case-preserved. Default below.
AGENTIC_BRANCH_PREFIX=atom
# Compaction POLICY window (tokens) for the agentic tool loop — caps per-call transcript
# size; compaction fires at window × AGENTIC_COMPACT_AT_FRACTION (default 0.8). The right
# value depends on whether PROMPT CACHING works for your provider, not on the model limit:
#   AiNxt prod (LLM_PROVIDER=ainxt): caching does NOT function through the gateway
#   (docs/ainxt_messages_compat.md) — every call re-bills the full transcript uncached,
#   so a SMALLER window is cheaper. Recommended:
#     AGENTIC_CONTEXT_WINDOW_TOKENS=500000
#     AGENTIC_COMPACT_HISTORY_THRESHOLD_CHARS=1500000   # char-fallback trigger; scale with window
#   Direct Anthropic (LLM_PROVIDER=claude): caching works (cache reads bill at 0.1×), so a
#   LARGER window is cheaper — keep the 1M default; do NOT copy the AiNxt values.
# Read at container CREATE: recreate backend + celery after changing (restart is not enough).
# AGENTIC_CONTEXT_WINDOW_TOKENS=500000
# AGENTIC_COMPACT_HISTORY_THRESHOLD_CHARS=1500000

# ── Scheduled ingest (Celery beat) ───────────────────────────────────────────
USE_INCREMENTAL_INGEST=True
USE_SCHEDULED_INGEST=False
SCHEDULER_INGEST_INTERVAL_MINUTES=30

# ── Cassandra (OLTP backup status lookups) ───────────────────────────────────
# Consumed by app/services/cassandra_txn_client.py via
# CassandraConfig.from_env(). Tables read:
#   <keyspace>.<prefix>_txn_backup_<YYYYMMDD>       (kind="fin")
#   <keyspace>.<prefix>_meta_txn_backup_<YYYYMMDD>  (kind="meta")
#
# HOSTS is required; everything else has sensible defaults. Auth is OFF when
# CASSANDRA_PASSWORD is blank — leave it blank for local clusters with no auth.
CASSANDRA_HOSTS=127.0.0.1
CASSANDRA_PORT=9042
CASSANDRA_USERNAME=
CASSANDRA_PASSWORD=
CASSANDRA_KEYSPACE=oltp_backup
# CASSANDRA_LOCAL_DC=dc1                  # set for multi-DC clusters
CASSANDRA_CONSISTENCY=LOCAL_ONE           # ONE | LOCAL_ONE | QUORUM | LOCAL_QUORUM | ALL
CASSANDRA_REQUEST_TIMEOUT=15
CASSANDRA_CONNECT_TIMEOUT=10
CASSANDRA_PROTOCOL_VERSION=4
# TLS — leave USE_SSL=false unless the cluster is configured for it.
CASSANDRA_USE_SSL=false
# CASSANDRA_SSL_CA_CERT=/path/to/ca.pem
# CASSANDRA_SSL_CERT=/path/to/client.pem
# CASSANDRA_SSL_KEY=/path/to/client.key

# ── Precert engine database (OFF by default) ─────────────────────────────────
# Only read when PRECERT_ENGINE_ENABLED=true. The engine talks directly to the
# precert simulator's own Postgres database.
#
# PRECERT_ENGINE_DB_PASSWORD used to default to the dev-compose Postgres
# password in app/core/config.py. It now defaults to "" like every other
# credential. docker-compose.yml now requires POSTGRES_PASSWORD to be set
# explicitly, so set this here to whatever the precert Postgres was started with.
# PRECERT_ENGINE_ENABLED=false
# PRECERT_ENGINE_DB_HOST=atom_postgres
# PRECERT_ENGINE_DB_PORT=5432
# PRECERT_ENGINE_DB_USER=atom_user
# PRECERT_ENGINE_DB_PASSWORD=
# PRECERT_ENGINE_DB_NAME=precertdb
#
# TLS to the precert simulator itself (not the database above).
#
# DEFAULTS TO TRUE. This connector used to accept ANY certificate
# unconditionally (CERT_NONE) on a channel carrying the network test transaction data.
# That was tolerated while the precert simulator shipped in this repo with a
# self-signed certificate; it was removed in commit b25b4ea and the engine is
# dormant (PRECERT_ENGINE_ENABLED=false), so there is no longer a working
# integration to protect and the default is inverted.
#
# If you revive the engine, set PRECERT_ENGINE_CA_CERT_PATH at the same time as
# PRECERT_ENGINE_ENABLED: verification is on, and with no CA file every call
# fails loudly at connect time. That is intended — better than silently
# trusting a forged certificate.
#
# Hostname verification stays off even when verifying: the simulator's
# certificate carried no SubjectAlternativeName, so enabling it would reject
# every connection. Chain validation is what closes the MITM hole; the hostname
# residual (CWE-297) needs a reissued certificate.
#
# PRECERT_ENGINE_VERIFY_PEERS=false is still accepted for a local experiment,
# but startup_validation refuses to boot production with the engine ENABLED and
# verification off, so it cannot be promoted by accident.
# PRECERT_ENGINE_VERIFY_PEERS=true
# PRECERT_ENGINE_CA_CERT_PATH=

# ── Cert-agent (SENDER side of the X-Internal-Token contract) ────────────────
# This backend calls the cert-agent service and attaches the shared secret as
# the `X-Internal-Token` header on every request (app/api/cert_push.py,
# app/services/cert_orchestrator.py). The cert-agent verifies it.
#
# The receiving service is NOT in this repository — it is the external
# certagent stack that also owns the `certagent_cert-net` docker network. Set
# the same value there under whatever name that deployment uses for it; this
# file can only document the sending half.
#
# Both sides must hold the BYTE-IDENTICAL value: it is compared with
# hmac.compare_digest, so a single stray character (a trailing newline from
# `echo`, a smart quote pasted from a doc) makes every call fail with a 401 and
# no other symptom. Use `printf '%s'` rather than `echo` when writing it to a
# file, and check the lengths match on both sides if you see blanket 401s.
#
# Expected value: a long, random, URL-safe string. Generate one with
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Default if unset: "" (empty) — calls to the cert-agent send no
# X-Internal-Token header at all until you set this. (It used to default to
# the published literal "dev-internal-token"; that shipped-secret default was
# removed as part of closing SCR findings #3/#9 — a hardcoded credential is a
# finding regardless of whether a production guard exists.) Set this
# explicitly in every environment that talks to a real cert-agent, including
# local/UAT; a startup warning fires if it's left unset there, and production
# refuses to boot on an unset or legacy value (see
# _check_internal_token_not_default in app/core/config.py).
#
# Rotation: update the cert-agent to accept the new value FIRST (it can accept
# old and new during the overlap), then change it here, then retire the old one.
# Changing this side first breaks every call immediately.
# CERT_AGENT_URL=http://cert-agent:8000
# CERT_AGENT_INTERNAL_TOKEN=

# ── SSRF guard (operator-supplied outbound URLs) ─────────────────────────────
# Guards the partner registry's `endpoint_url` and the cert-a2a trigger's raw
# endpoint. The backend fetches these server-side, from inside the network
# perimeter, and returns the response body — so an unrestricted value lets an
# admin-authenticated request read internal services (app/core/ssrf_guard.py).
#
# Enforced BY DEFAULT. The guard resolves the hostname, classifies the resulting
# addresses, and PINS the vetted address for the fetch so the name cannot be
# rebound in between. It replaced a prefix blocklist whose entries all began
# "http://", so https:// bypassed every one — including
# https://169.254.169.254 (cloud metadata, which issues IAM credentials).
#
# SSRF_GUARD_MODE
#   enforce (default) — refuse loopback / link-local / multicast / private
#     targets with 400, and pin the resolved address.
#   observe — log what WOULD be refused, reject nothing. Use for a staged
#     rollout on an environment whose internal partners are not yet allowlisted.
#   off — no checking. Escape hatch only.
#   Anything unrecognised is treated as enforce, so a typo fails safe.
# SSRF_GUARD_MODE=enforce
#
# SSRF_ALLOWED_INTERNAL_HOSTS
#   Comma-separated hosts exempt from the guard — the precise way to permit a
#   known internal partner. Matched on the URL host, case-insensitively.
# SSRF_ALLOWED_INTERNAL_HOSTS=partner.internal,10.20.30.40
#
# SSRF_ALLOW_PRIVATE_NETWORKS
#   Blanket permission for RFC-1918 space (10/8, 172.16/12, 192.168/16 and the
#   IPv6 equivalents) when naming each internal partner is impractical.
#   Loopback, link-local (the metadata range), multicast and unspecified stay
#   blocked regardless — no partner is ever legitimately reachable there.
#   Prefer SSRF_ALLOWED_INTERNAL_HOSTS: it is narrower.
# SSRF_ALLOW_PRIVATE_NETWORKS=false
#
# If a legitimate partner is refused after upgrading: the log line names the
# host and the reason. Add it to SSRF_ALLOWED_INTERNAL_HOSTS (preferred), or set
# SSRF_ALLOW_PRIVATE_NETWORKS=true if the deployment is entirely internal.

# ── Cleartext transport policy (CWE-319) ─────────────────────────────────────
# A SEPARATE control from the SSRF settings above, and deliberately so. SSRF
# asks "could this URL reach somewhere it shouldn't?" — for which public is
# fine and private is suspect. This asks the INVERTED question, "would this put
# plaintext on a network we don't control?" — for which private is the only
# acceptable answer for http:// and public cleartext is refused.
#
#     SSRF        public → allow,         private → block
#     cleartext   private + http → allow, public + http → block
#
# Sharing one switch would mean loosening SSRF for an internal partner silently
# also permitted cleartext to the open internet.
#
# CLEARTEXT_POLICY_MODE
#   enforce (default) — refuse http:// to a destination that does not resolve
#                       to loopback or an RFC-1918 address
#   observe           — log what would be refused, send anyway
#   off               — no checking
# Enforcing by default is non-breaking: docker service names (cert-agent,
# bank-agent) and localhost resolve privately and pass unchanged.
# CLEARTEXT_POLICY_MODE=enforce
#
# CLEARTEXT_ALLOWED_HOSTS
#   Comma-separated hostnames exempt from the rule — for a destination that
#   cannot resolve privately but is reached over a trusted link (fixed VPN
#   peer, lab box). Prefer switching the target to https:// over widening this.
# CLEARTEXT_ALLOWED_HOSTS=
#
# The cert-agent service enforces the same rule on its own outbound sends via
# its own AGENT_CLEARTEXT_POLICY setting. It has a separate dependency tree and
# cannot import this backend's guard, so the logic is mirrored rather than
# shared — keep the two in step. That service is external to this repository,
# so the mirroring is a coordination duty and no gate here can check it.
