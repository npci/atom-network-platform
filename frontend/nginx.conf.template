# RECONSTRUCTED — this trimmed checkout ships without this file . Rebuilt from first principles by reading
# docker-entrypoint.sh (only $CONTEXT_PATH is envsubst'd — every other $var
# below is a literal nginx variable and must survive untouched) and the outer
# nginx.dev.conf.template, whose `location /${AUTHORITY_CONTEXT}/ { proxy_pass
# http://authority_frontend; }` has NO rewrite and NO URI on proxy_pass — so the
# full `/a2a/...` path arrives here unchanged, and this config must serve
# static files rooted at that same prefix.
server {
    listen 80;
    server_tokens off;

    # Security headers for the SPA's OWN responses (the HTML document and the JS
    # bundle). These were absent: the only headers in the stack came from
    # app/main.py middleware, which decorates /api/* JSON and never touches these
    # bytes — they are served off disk from this container. So the page an
    # attacker would actually frame carried no X-Frame-Options, and the document
    # that runs all the JavaScript carried no CSP at all. (app/main.py's comment
    # claiming this file "already sets these" was stale — corrected there too.)
    #
    # `always` so they survive on error responses as well as 200s.
    #
    # NOTE ON INHERITANCE: nginx `add_header` is inherited by a location only if
    # that location defines NO add_header of its own. Neither location below
    # does. If you ever add one to a location, you must repeat this whole block
    # there or the location silently loses every header.
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;

    # CSP notes, directive by directive — this app was checked against each:
    #   script-src 'self'      — index.html has no inline script (the module tag
    #                            carries a src) and nothing uses eval/new Function.
    #                            No 'unsafe-inline'/'unsafe-eval': that is the
    #                            directive doing the real XSS work.
    #   style-src  + unsafe-inline — Tailwind compiles to a file, but keeping this
    #                            avoids breaking any runtime-injected <style>.
    #                            React's style={{}} sets CSSOM and needs no
    #                            exemption. Inline STYLE is a far smaller risk
    #                            than inline script.
    #   img-src    https:      — VITE_BRAND_LOGO_URL is operator-configurable and
    #                            may point at an external CDN.
    #   frame-src 'self' blob: — also what stops a sandboxed prototype-preview
    #                            iframe (utils/safeHtmlFrame.js) from navigating
    #                            ITSELF to an attacker origin to exfiltrate the
    #                            LLM-generated content it renders. The frame's own
    #                            meta-CSP cannot express that; only the parent's
    #                            frame-src can.
    #   connect-src ws: wss:   — the app opens same-origin WebSockets for agent
    #                            and phase streams.
    #   worker-src 'self' blob: — pages/Admin/regexTester.worker.js. Vite emits it
    #                            as a same-origin file so script-src would cover
    #                            it, but worker-src is stated explicitly because
    #                            the fallback chain (worker-src -> child-src ->
    #                            script-src) is easy to break by accident, and
    #                            blob: keeps it working if the bundler ever
    #                            switches to a blob worker.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' ws: wss:; media-src 'self' blob:; worker-src 'self' blob:; frame-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'" always;

    location = / {
        return 302 /$CONTEXT_PATH/;
    }

    # `alias` (not `root`) strips the location prefix from the filesystem
    # path: a request for /$CONTEXT_PATH/assets/x.js resolves to
    # /usr/share/nginx/html/assets/x.js. try_files falls back to index.html
    # for client-side (React Router) routes.
    location /$CONTEXT_PATH/ {
        alias /usr/share/nginx/html/;
        try_files $uri $uri/ /$CONTEXT_PATH/index.html;

        # Anchor relative asset URLs at the public prefix.
        #
        # index.html references its assets RELATIVELY ("./assets/x.js") and
        # Vite emits no <base> tag. Served at /$CONTEXT_PATH/ those resolve
        # correctly, but a refresh on a deep link — /$CONTEXT_PATH/changes/123
        # — resolves them against the DIRECTORY of that URL, i.e.
        # /$CONTEXT_PATH/changes/assets/x.js.
        #
        # THAT REQUEST RETURNS 200, NOT 404: the try_files SPA fallback above
        # answers it with index.html. So the browser asks for JavaScript, is
        # handed HTML with a 200, the module fails to parse, and the page is
        # blank with nothing red in the Network tab. Check content type, not
        # status, when verifying this:
        #     curl -so /dev/null -w '%{http_code} %{content_type}\n' \
        #          http://host/$CONTEXT_PATH/deep/link/assets/<bundle>.js
        # must report application/javascript, never text/html.
        #
        # frontend/src/utils/basePath.js reads this exact tag and falls back to
        # a hardcoded '/a2a/' when it is absent — which is why a wrong
        # CONTEXT_PATH fails quietly rather than loudly.
        #
        # THIS BELONGS HERE, IN THE IMAGE, not in the outer proxy. It lived in
        # nginx/nginx.dev.conf.template, which fixed the deployed stack and left
        # this image serving a blank page to anyone running it directly. Do not
        # reinstate it there — two sub_filters produce two <base> tags.
        #
        # No `proxy_set_header Accept-Encoding ""` is needed at this hop: these
        # bytes come off disk, not from an upstream. An nginx that PROXIES this
        # response and wants to rewrite it does need it — sub_filter cannot
        # touch a gzipped body and passes it through unmodified, so the fix
        # looks applied and does nothing.
        sub_filter '<head>' '<head><base href="/$CONTEXT_PATH/">';
        sub_filter_once on;
        sub_filter_types text/html;
    }
}
